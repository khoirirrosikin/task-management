### =========================================================================
### Task Management API — HTTP Client Test Scenarios
### =========================================================================

@baseUrl = http://localhost:8080/api/v1
@contentType = application/json

### 1. HEALTH CHECK
GET http://localhost:8080/health
Content-Type: {{contentType}}


### =========================================================================
### 2. AUTHENTICATION MODULE
### =========================================================================

### 2.1. Register Owner / Primary User (Success)
# @name registerOwner
POST {{baseUrl}}/auth/register
Content-Type: {{contentType}}

{
  "name": "Khoirir Rosikin",
  "email": "khoirir.rosikin@gmail.com",
  "password": "secretpassword123"
}

### 2.2. Register User (Duplicate Email - Expected 409 Conflict)
POST {{baseUrl}}/auth/register
Content-Type: {{contentType}}

{
  "name": "Khoirir Rosikin",
  "email": "khoirir.rosikin@gmail.com",
  "password": "secretpassword123"
}

### 2.3. Login Owner / Primary User (Success)
# @name loginOwner
POST {{baseUrl}}/auth/login
Content-Type: {{contentType}}

{
  "email": "khoirir.rosikin@gmail.com",
  "password": "secretpassword123"
}

### Extract auth token from login response above
@authToken = {{loginOwner.response.body.data.token}}

### 2.4. Login User (Wrong Password - Expected 401 Unauthorized)
POST {{baseUrl}}/auth/login
Content-Type: {{contentType}}

{
  "email": "khoirir.rosikin@gmail.com",
  "password": "wrongpassword"
}

### 2.5. Register Collaborator User (Success)
# @name registerCollaborator
POST {{baseUrl}}/auth/register
Content-Type: {{contentType}}

{
  "name": "Jane Collaborator",
  "email": "jane.collaborator@example.com",
  "password": "collabpassword123"
}

### Extract collaborator email
@collaboratorEmail = jane.collaborator@example.com


### =========================================================================
### 3. PROJECT MODULE
### =========================================================================

### 3.1. Create Project (Success)
# @name createProject
POST {{baseUrl}}/projects
Content-Type: {{contentType}}
Authorization: Bearer {{authToken}}

{
  "name": "Task Management Project",
  "description": "Building a robust Task Management API with Go and PostgreSQL"
}

### Extract project ID from response above
@projectId = {{createProject.response.body.data.id}}

### 3.2. Create Project (Validation Error - Expected 400 Bad Request)
POST {{baseUrl}}/projects
Content-Type: {{contentType}}
Authorization: Bearer {{authToken}}

{
  "name": ""
}

### 3.3. List Projects (Success)
GET {{baseUrl}}/projects
Authorization: Bearer {{authToken}}

### 3.4. Get Project by ID (Success)
GET {{baseUrl}}/projects/{{projectId}}
Authorization: Bearer {{authToken}}

### 3.5. Update Project (Success)
PUT {{baseUrl}}/projects/{{projectId}}
Content-Type: {{contentType}}
Authorization: Bearer {{authToken}}

{
  "name": "Task Management API (Updated)",
  "description": "Updated project description with complete features"
}


### =========================================================================
### 4. PROJECT MEMBERS MODULE
### =========================================================================

### 4.1. Add Project Member (Success)
# @name addMember
POST {{baseUrl}}/projects/{{projectId}}/members
Content-Type: {{contentType}}
Authorization: Bearer {{authToken}}

{
  "email": "{{collaboratorEmail}}",
  "role": "member"
}

### Extract member user ID from response above
@memberUserId = {{addMember.response.body.data.user_id}}

### 4.2. Add Project Member (Validation Error - Invalid Email)
POST {{baseUrl}}/projects/{{projectId}}/members
Content-Type: {{contentType}}
Authorization: Bearer {{authToken}}

{
  "email": "invalid-email-address",
  "role": "member"
}

### 4.3. Add Project Member (Cannot Add Self - Expected 400 Bad Request)
POST {{baseUrl}}/projects/{{projectId}}/members
Content-Type: {{contentType}}
Authorization: Bearer {{authToken}}

{
  "email": "khoirir.rosikin@gmail.com",
  "role": "member"
}

### 4.4. List Project Members (Success)
GET {{baseUrl}}/projects/{{projectId}}/members
Authorization: Bearer {{authToken}}

### 4.5. Update Member Role (Success)
PUT {{baseUrl}}/projects/{{projectId}}/members/{{memberUserId}}
Content-Type: {{contentType}}
Authorization: Bearer {{authToken}}

{
  "role": "owner"
}

### 4.6. Remove Member from Project (Success)
DELETE {{baseUrl}}/projects/{{projectId}}/members/{{memberUserId}}
Authorization: Bearer {{authToken}}


### =========================================================================
### 5. TASK MODULE
### =========================================================================

### 5.1. Create Task 1 - Todo / High Priority (Success)
# @name createTask1
POST {{baseUrl}}/projects/{{projectId}}/tasks
Content-Type: {{contentType}}
Authorization: Bearer {{authToken}}

{
  "title": "Design Database Schema",
  "description": "Create goose migrations for users, projects, and tasks",
  "status": "todo",
  "priority": "high",
  "due_date": "2026-10-15T18:00:00Z"
}

### Extract task ID from response above
@taskId = {{createTask1.response.body.data.id}}

### 5.2. Create Task 2 - In Progress / Medium Priority (Success)
POST {{baseUrl}}/projects/{{projectId}}/tasks
Content-Type: {{contentType}}
Authorization: Bearer {{authToken}}

{
  "title": "Implement Unit Tests",
  "description": "Write service and handler unit tests with testify/mock",
  "status": "in_progress",
  "priority": "medium"
}

### 5.3. Create Task (Validation Error - Title Too Short / Empty)
POST {{baseUrl}}/projects/{{projectId}}/tasks
Content-Type: {{contentType}}
Authorization: Bearer {{authToken}}

{
  "title": "A",
  "status": "todo"
}

### 5.4. Create Task (Assignee Not a Project Member - Expected 400 Bad Request)
POST {{baseUrl}}/projects/{{projectId}}/tasks
Content-Type: {{contentType}}
Authorization: Bearer {{authToken}}

{
  "title": "Task Assigned to Non-Member",
  "status": "todo",
  "assigned_to": "00000000-0000-0000-0000-000000000001"
}

### 5.5. List Tasks by Project (Success - Default Pagination)
GET {{baseUrl}}/projects/{{projectId}}/tasks
Authorization: Bearer {{authToken}}

### 5.5.1. List Tasks with Search, Filter & Pagination (Success)
GET {{baseUrl}}/projects/{{projectId}}/tasks?search=Schema&status=todo&priority=high&page=1&limit=5
Authorization: Bearer {{authToken}}

### 5.5.2. List Tasks with Invalid Filter (Validation Error - Expected 400 Bad Request)
GET {{baseUrl}}/projects/{{projectId}}/tasks?status=invalid_status
Authorization: Bearer {{authToken}}

### 5.6. Get Task by ID (Success)
GET {{baseUrl}}/tasks/{{taskId}}
Authorization: Bearer {{authToken}}

### 5.7. Update Task - Change Status to Completed (Success)
PUT {{baseUrl}}/tasks/{{taskId}}
Content-Type: {{contentType}}
Authorization: Bearer {{authToken}}

{
  "title": "Design Database Schema (Done)",
  "status": "completed",
  "priority": "urgent"
}

### 5.8. Update Task (Validation Error - Invalid Status)
PUT {{baseUrl}}/tasks/{{taskId}}
Content-Type: {{contentType}}
Authorization: Bearer {{authToken}}

{
  "status": "pending_approval"
}

### 5.9. Add Comment to Task (Success)
# @name addComment
POST {{baseUrl}}/tasks/{{taskId}}/comments
Content-Type: {{contentType}}
Authorization: Bearer {{authToken}}

{
  "content": "Database schema looks solid, ready for review!"
}

### Extract comment ID from response above
@commentId = {{addComment.response.body.data.id}}

### 5.10. Add Comment to Task (Validation Error - Empty Content)
POST {{baseUrl}}/tasks/{{taskId}}/comments
Content-Type: {{contentType}}
Authorization: Bearer {{authToken}}

{
  "content": ""
}

### 5.11. List Task Comments (Success)
GET {{baseUrl}}/tasks/{{taskId}}/comments
Authorization: Bearer {{authToken}}

### 5.12. Delete Task Comment (Success)
DELETE {{baseUrl}}/tasks/{{taskId}}/comments/{{commentId}}
Authorization: Bearer {{authToken}}

### 5.13. Delete Task (Success)
DELETE {{baseUrl}}/tasks/{{taskId}}
Authorization: Bearer {{authToken}}

### 5.14. Get Deleted Task (Expected 404 Not Found)
GET {{baseUrl}}/tasks/{{taskId}}
Authorization: Bearer {{authToken}}


### =========================================================================
### 6. CLEANUP / DELETE PROJECT
### =========================================================================

### 6.1. Delete Project (Success)
DELETE {{baseUrl}}/projects/{{projectId}}
Authorization: Bearer {{authToken}}

### 6.2. Get Deleted Project (Expected 404 Not Found)
GET {{baseUrl}}/projects/{{projectId}}
Authorization: Bearer {{authToken}}


### =========================================================================
### 7. SECURITY & UNAUTHORIZED SCENARIOS
### =========================================================================

### 7.1. Access Protected Route Without Token (Expected 401 Unauthorized)
GET {{baseUrl}}/projects

### 7.2. Access Protected Route With Invalid/Tampered Token (Expected 401 Unauthorized)
GET {{baseUrl}}/projects
Authorization: Bearer invalid_jwt_token_here
